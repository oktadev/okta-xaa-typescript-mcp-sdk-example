# ── xaa.dev registration ─────────────────────────────────────────────────────
# App credentials — the pair labeled for the app / OIDC login (Step 1)
XAA_CLIENT_ID=
XAA_CLIENT_SECRET=


# Token-exchange credentials — the pair labeled for token exchange (Step 2).
# If your registration modal shows the SAME client_id as the app pair,
# leave these empty (the app pair is used automatically).
EXCHANGE_CLIENT_ID=
EXCHANGE_CLIENT_SECRET=


# Resource client credentials — the pair whose id ends in "-at-<resource>"
# (e.g. client_xxx-at-todo0-mcp). Used only for the RFC 7523 JWT bearer grant (Step 3).
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=


# ── xaa.dev endpoints (defaults are correct; no trailing slashes!) ───────────
IDP_BASE_URL=https://idp.xaa.dev
AUTH_SERVER_URL=https://auth.resource.xaa.dev
MCP_SERVER_URL=https://mcp.xaa.dev/mcp


# ── Local app ─────────────────────────────────────────────────────────────────
# Register BASE_URL + /callback as the redirect URI on xaa.dev
PORT=3001
BASE_URL=http://localhost:3001


# Scopes requested in the ID-JAG token exchange
XAA_SCOPE=todos.read mcp.access
